# Configuration SecAudit. Copier en cybersec.env (non versionné) et adapter.
# Format : CLE=valeur. %VARIABLE% et ~ sont développés.

# Dossier racine de TOUS les rapports, où que le scan soit lancé :
#   <racine>\<nom du dossier scanné>\<date-heure>\   (+ metadata.json)
# Défaut si vide : ~\.secaudit\reports
SECAUDIT_REPORT_ROOT=C:\cybersec\local-report
