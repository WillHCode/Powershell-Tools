# Configuration Kubernetes. Copier en kube.env (non versionné) et remplir.
# Format : CLE=valeur. %VARIABLE% et ~ sont développés.

# Contextes protégés par le garde-fou (écriture => confirmation YES).
# Séparés par des virgules, jokers acceptés. Défaut si vide : *prod*
KUBE_PROTECTED_CONTEXTS=*prod*

# Cibles des raccourcis kube-prod / kube-staging
KUBE_PROD_CONTEXT=
KUBE_STAGING_CONTEXT=

# Facultatif : binaire kubectl (sinon celui du PATH)
#KUBECTL_PATH=C:\Program Files\Docker\Docker\resources\bin\kubectl.exe

# Facultatif : kubeconfig utilisé dans le terminal `kube` uniquement
# (variable standard lue par kubectl, helm et le prompt oh-my-posh)
#KUBECONFIG=%USERPROFILE%\.kube\config
