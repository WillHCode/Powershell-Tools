<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>SecAudit.Finding</Name>
      <ViewSelectedBy>
        <TypeName>SecAudit.Finding</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Gravité</Label><Width>9</Width></TableColumnHeader>
          <TableColumnHeader><Label>Outil</Label><Width>18</Width></TableColumnHeader>
          <TableColumnHeader><Label>Règle</Label><Width>30</Width></TableColumnHeader>
          <TableColumnHeader><Label>Fichier</Label><Width>40</Width></TableColumnHeader>
          <TableColumnHeader><Label>Message</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <ScriptBlock>
                  $c = switch ($_.Gravite) {
                    'CRITICAL' { $PSStyle.Foreground.BrightRed }
                    'HIGH'     { $PSStyle.Foreground.Red }
                    'MEDIUM'   { $PSStyle.Foreground.Yellow }
                    default    { $PSStyle.Foreground.BrightBlack }
                  }
                  "$c$($_.Gravite)$($PSStyle.Reset)"
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem><PropertyName>Outil</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Regle</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Fichier</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Message</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
